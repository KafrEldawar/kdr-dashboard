# Production Supabase project (KDR Restuarants — spider org)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required for admin operations (create/delete users). Get from Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Dev Supabase project (KDR Restaurants-dev — KDR Org).
# Set both values to enable the in-app prod/dev switcher in the header.
NEXT_PUBLIC_SUPABASE_URL_DEV=
NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_DEV=

WA_SERVICE_URL=

# Shared secret with Supabase Edge Functions for HMAC request signing.
# 32+ bytes of hex/base64. Same value must be set in Supabase secrets.
WA_SHARED_SECRET=

# Admin token for /session/* endpoints (browser dashboard calls).
# Long random string. The Next.js dashboard reads this via a
# server-side proxy route so the browser never sees it.
WA_ADMIN_TOKEN=